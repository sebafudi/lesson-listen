{
  "manifest_version": 3,
  "name": "Lesson Listen",
  "version": "0.1.0",
  "description": "Skip buttons, text timestamps, local Parakeet sync and read-along tracking for MEGA.dev lesson audio.",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://hq.mega.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hq.mega.dev/*"
      ],
      "js": [
        "shared/settings.js",
        "content/timing.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Lesson Listen settings",
    "default_popup": "options/options.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
